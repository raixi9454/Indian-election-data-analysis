      <column caption='voter turnout %' datatype='real' name='[Calculation_1903615271222009856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total_Votes_Polled] / [electors]* 100' />
      </column>
      <column caption='voter turnout %(correct)' datatype='real' name='[Calculation_1903615271222071297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [state]:MIN([Calculation_1903615271222009856])}' />
      </column>
